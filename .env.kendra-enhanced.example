# Kendra Enhanced RAG Configuration Example
# Copy this file to .env.local and update values

# API Endpoints (update after CDK deployment)
VITE_APP_RAG_KENDRA_RETRIEVE_ENDPOINT=https://your-api-gateway-url/rag/kendra-enhanced

# Feature Flags
VITE_APP_ENABLE_RAG_OPTIMIZATION=true
VITE_APP_ENABLE_ADVANCED_SEARCH=true
VITE_APP_ENABLE_USER_CONTEXT=true
VITE_APP_ENABLE_PERFORMANCE_METRICS=true
VITE_APP_ENABLE_FEEDBACK_SYSTEM=true

# Performance Optimization Settings
VITE_APP_CACHE_ENABLED=true
VITE_APP_CACHE_TTL=300000 # 5 minutes in milliseconds
VITE_APP_PREFETCH_ENABLED=true
VITE_APP_STREAMING_ENABLED=true

# A/B Testing Configuration (optional)
VITE_APP_FEATURE_ROLLOUT_PERCENTAGE=10 # Start with 10% of users
VITE_APP_FEATURE_ROLLOUT_GROUPS=test-group,early-adopters

# Debug Settings (development only)
VITE_APP_DEBUG_KENDRA_QUERIES=false
VITE_APP_LOG_PERFORMANCE_METRICS=true